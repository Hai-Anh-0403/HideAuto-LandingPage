# ==============================================================================
# HideAuto Monorepo .gitignore
# Next.js (Frontend) + NestJS (Backend)
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js & Frontend Build Outputs
.next/
.next-build/
.next-build-*/
.next-old/
out/
build/

# Backend Build Outputs (NestJS / TypeScript)
dist/
/backend/dist/

# Testing & Coverage
coverage/
.nyc_output/

# Environment Variables
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript
*.tsbuildinfo

# OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Temporary, Cache & Scratch Files
.cache/
.temp/
.tmp/
scratch/
scratch_*.json

# Vercel & Turbopack
.vercel/
.turbo/
